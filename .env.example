CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

#docker-compose.yml de enviroment icinde override oluo
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/agent_flow
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_API_KEY=centrifugo_api_key
CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

DJANGO_SECRET_KEY=dev-insecure-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Harici MCP sunucusu (bos birakilirsa agent baglanmaz)
EXTERNAL_MCP_URL=
EXTERNAL_MCP_TOKEN=
